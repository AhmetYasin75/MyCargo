@model LoginUserDto
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="max-w-md mx-auto">
    <div class="text-center mb-stack-lg">
        <h1 class="text-headline-lg text-on-background mb-2">Giriş Yap</h1>
        <p class="text-on-surface-variant">Kargolarınızı yönetmek için hesabınıza giriş yapın.</p>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-outline-variant p-6 md:p-8 relative overflow-hidden">
        <div class="absolute -right-12 -top-12 opacity-5 pointer-events-none">
            <span class="material-symbols-outlined text-[160px] text-primary">lock</span>
        </div>

        <form method="post" class="flex flex-col gap-5 relative z-10">
            <div>
                <label class="block text-sm font-semibold text-on-background mb-1">Kullanıcı Adı</label>
                <input type="text" asp-for="UserName" required
                       class="w-full border border-outline-variant rounded px-4 py-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-surface-bright h-[48px]" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-on-background mb-1">Şifre</label>
                <input type="password" asp-for="Password" required
                       class="w-full border border-outline-variant rounded px-4 py-3 text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary bg-surface-bright h-[48px]" />
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="flex items-start gap-2 bg-error-container text-on-error-container px-4 py-3 rounded" asp-validation-summary="All"></div>
            }

            <button type="submit"
                    class="bg-secondary-container text-on-primary px-8 py-3 rounded font-semibold flex items-center justify-center gap-2 hover:opacity-90 transition-opacity h-[48px] shadow-sm">
                <span class="material-symbols-outlined text-sm font-bold">login</span>
                Giriş Yap
            </button>
        </form>
    </div>

    <p class="text-center text-on-surface-variant mt-6">
        Hesabın yok mu?
        <a href="/Register/Signup" class="text-secondary font-bold hover:underline">Kayıt Ol</a>
    </p>
</div>
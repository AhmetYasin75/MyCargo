@using CargoTrack.DTO.DTOs.Cargos
@using CargoTrack.Entity.Entities.Enums
@using CargoTrack.WebUI.Helpers
@model CargoDetailDto
@{
    ViewData["Title"] = "Kargo Detayı";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Neden: Hangi formların görüneceğini servis belirler (Controller ViewBag'e koyar).
    var actions = (CargoActionsDto)ViewBag.Actions;
}

<h3>Kargo Detayı: @Model.TrackCode</h3>

<p>
    <span class="badge @EnumDisplay.StatusBadge(Model.CargoStatus) fs-6">@EnumDisplay.Status(Model.CargoStatus)</span>
    @if (Model.IsOverdue)
    {
        <span class="badge bg-danger fs-6">Gecikmiş</span>
    }
</p>

<div class="row">
    <div class="col-md-6">
        <table class="table table-bordered">
            <tr><th style="width:40%">Gönderici</th><td>@Model.SenderFirstName @Model.SenderLastName</td></tr>
            <tr><th>Alıcı</th><td>@Model.ReceiverFirstName @Model.ReceiverLastName</td></tr>
            <tr><th>Çıkış Şubesi</th><td>@Model.OriginBranchName</td></tr>
            <tr><th>Varış Şubesi</th><td>@Model.DestinationBranchName</td></tr>
            <tr><th>Kargo Tipi</th><td>@EnumDisplay.Type(Model.CargoType)</td></tr>
            <tr><th>Teslimat Tipi</th><td>@EnumDisplay.Delivery(Model.DeliveryType)</td></tr>
        </table>
    </div>

    <div class="col-md-6">
        <table class="table table-bordered">
            <tr><th style="width:40%">Ağırlık</th><td>@Model.Weight kg</td></tr>
            <tr><th>Ölçüler (En x Boy x Yükseklik)</th><td>@Model.Width x @Model.Length x @Model.Height cm</td></tr>
            <tr><th>Desi</th><td>@Model.Desi</td></tr>
            <tr><th>Ücret</th><td>@MoneyFormat.TL(Model.Price) @(Model.HasInsurance ? "(sigortalı)" : "")</td></tr>
            <tr><th>Gönderim Tarihi</th><td>@Model.ShipmentDate.ToString("dd.MM.yyyy HH:mm")</td></tr>
            <tr><th>Tahmini Teslim</th><td>@Model.EstimatedArrivalDate.ToString("dd.MM.yyyy")</td></tr>
            <tr><th>Teslim Tarihi</th><td>@(Model.DeliveredDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td></tr>
            <tr><th>Başarısız Deneme</th><td>@Model.FailedDeliveryAttempts</td></tr>
        </table>
    </div>
</div>

@* ---------------- OPERASYON FORMLARI (sadece işlem yetkisi olana) ---------------- *@
@if (actions.CanOperate)
{
    <h4 class="mt-3">İşlemler</h4>

    @if (!actions.NextStatuses.Any() && !actions.CanVerifyDelivery && !actions.CanReportFailure)
    {
        <div class="alert alert-secondary">Bu kargo için yapılabilecek bir işlem yok.</div>
    }

    <div class="row g-3 mb-4">

        @* 1) Durum değiştir *@
        @if (actions.NextStatuses.Any())
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header">Durum Değiştir</div>
                    <div class="card-body">
                        <form asp-controller="Cargo" asp-action="ChangeStatus" method="post">
                            <input type="hidden" name="CargoId" value="@Model.Id" />

                            <div class="mb-2">
                                <label class="form-label">Yeni Durum</label>
                                <select name="NewStatus" id="newStatus" class="form-select">
                                    @foreach (var s in actions.NextStatuses)
                                    {
                                        <option value="@((int)s)">@EnumDisplay.Status(s)</option>
                                    }
                                </select>
                            </div>

                            @* Neden: Transfer merkezi sadece "Transfer Merkezinde" durumunda sorulur *@
                            <div class="mb-2" id="transferCenterBox" style="display:none">
                                <label class="form-label">Transfer Merkezi</label>
                                <select name="TransferCenterId" class="form-select" asp-items="@((SelectList)ViewBag.TransferCenters)">
                                    <option value="">-- Seçiniz --</option>
                                </select>
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Açıklama</label>
                                <textarea name="Description" class="form-control" rows="2" maxlength="500" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-dark">Durumu Güncelle</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* 2) Teslimat kodu doğrula *@
        @if (actions.CanVerifyDelivery)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header">Teslimat Kodunu Doğrula</div>
                    <div class="card-body">
                        <form asp-controller="Cargo" asp-action="VerifyDelivery" method="post">
                            <input type="hidden" name="CargoId" value="@Model.Id" />

                            <div class="mb-2">
                                <label class="form-label">Teslimat Kodu (alıcının söylediği 6 hane)</label>
                                <input type="text" name="DeliveryCode" class="form-control" maxlength="6" inputmode="numeric" required />
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Teslim Alan Kişi</label>
                                <input type="text" name="ReceiverName" class="form-control" maxlength="100" required />
                            </div>

                            <button type="submit" class="btn btn-success">Teslim Et</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* 3) Teslim edilemedi *@
        @if (actions.CanReportFailure)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header">Teslim Edilemedi</div>
                    <div class="card-body">
                        <form asp-controller="Cargo" asp-action="ReportDeliveryFailure" method="post">
                            <input type="hidden" name="CargoId" value="@Model.Id" />

                            <div class="mb-2">
                                <label class="form-label">Neden</label>
                                <select name="Reason" class="form-select">
                                    @foreach (var r in Enum.GetValues<DeliveryExceptionReason>())
                                    {
                                        <option value="@((int)r)">@EnumDisplay.FailureReason(r)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-2">
                                <label class="form-label">Açıklama</label>
                                <textarea name="Description" class="form-control" rows="2" maxlength="500" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-danger">Başarısız Olarak Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h4 class="mt-3">Hareket Geçmişi</h4>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Durum</th>
            <th>Yer</th>
            <th>İşlemi Yapan</th>
            <th>Açıklama</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model.Timeline)
        {
            <tr>
                <td>@m.MovementDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    @if (m.OldStatus != m.NewStatus)
                    {
                        @EnumDisplay.Status(m.OldStatus) <span>→</span>
                    }
                    <span class="badge @EnumDisplay.StatusBadge(m.NewStatus)">@EnumDisplay.Status(m.NewStatus)</span>
                </td>
                <td>@(string.IsNullOrEmpty(m.TransferCenterName) ? m.BranchName : m.TransferCenterName)</td>
                <td>@m.PerformedByUserFirstName @m.PerformedByUserLastName</td>
                <td>@m.Description</td>
            </tr>
        }
    </tbody>
</table>

<a href="/Cargo/Index" class="btn btn-dark">Listeye Dön</a>

@* Neden: "Transfer Merkezinde" seçilince merkez listesini göster, diğer durumlarda gizle. *@
<script>
    (function () {
        var statusSelect = document.getElementById('newStatus');
        var box = document.getElementById('transferCenterBox');
        if (!statusSelect || !box) return;

        var transferValue = '@((int)CargoStatus.InTransferCenter)';
        function toggle() {
            box.style.display = statusSelect.value === transferValue ? 'block' : 'none';
        }
        statusSelect.addEventListener('change', toggle);
        toggle();
    })();
</script>
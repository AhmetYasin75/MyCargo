@using CargoTrack.DTO.DTOs.Cargos
@using CargoTrack.Entity.Entities.Enums
@using CargoTrack.WebUI.Helpers
@model CreateCargoDto
@{
    ViewData["Title"] = "Yeni Kargo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Yeni Kargo</h3>

<form method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <h5 class="mt-3">Taraflar</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="SenderId" class="form-label">Gönderici</label>
            <select asp-for="SenderId" asp-items="@((SelectList)ViewBag.Customers)" class="form-select">
                <option value="@Guid.Empty">-- Seçiniz --</option>
            </select>
            <span asp-validation-for="SenderId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="ReceiverId" class="form-label">Alıcı</label>
            <select asp-for="ReceiverId" asp-items="@((SelectList)ViewBag.Customers)" class="form-select">
                <option value="@Guid.Empty">-- Seçiniz --</option>
            </select>
            <span asp-validation-for="ReceiverId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="OriginBranchId" class="form-label">Çıkış Şubesi</label>
            <select asp-for="OriginBranchId" asp-items="@((SelectList)ViewBag.OriginBranches)" class="form-select">
                <option value="@Guid.Empty">-- Seçiniz --</option>
            </select>
            <span asp-validation-for="OriginBranchId" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="DestinationBranchId" class="form-label">Varış Şubesi</label>
            <select asp-for="DestinationBranchId" asp-items="@((SelectList)ViewBag.Branches)" class="form-select">
                <option value="@Guid.Empty">-- Seçiniz --</option>
            </select>
            <span asp-validation-for="DestinationBranchId" class="text-danger"></span>
        </div>
    </div>

    <h5 class="mt-4">Paket Bilgileri</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="Weight" class="form-label">Ağırlık (kg)</label>
            <input asp-for="Weight" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Width" class="form-label">En (cm)</label>
            <input asp-for="Width" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="Width" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Length" class="form-label">Boy (cm)</label>
            <input asp-for="Length" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="Length" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="Height" class="form-label">Yükseklik (cm)</label>
            <input asp-for="Height" type="number" step="0.01" min="0" class="form-control" />
            <span asp-validation-for="Height" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="CargoType" class="form-label">Kargo Tipi</label>
            <select asp-for="CargoType" class="form-select">
                @foreach (var type in Enum.GetValues<CargoType>())
                {
                    <option value="@((int)type)">@EnumDisplay.Type(type)</option>
                }
            </select>
            <span asp-validation-for="CargoType" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="DeliveryType" class="form-label">Teslimat Tipi</label>
            <select asp-for="DeliveryType" class="form-select">
                @foreach (var type in Enum.GetValues<DeliveryType>())
                {
                    <option value="@((int)type)">@EnumDisplay.Delivery(type)</option>
                }
            </select>
            <span asp-validation-for="DeliveryType" class="text-danger"></span>
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="HasInsurance" class="form-check-input" />
                <label asp-for="HasInsurance" class="form-check-label">Sigorta (ek hizmet)</label>
            </div>
        </div>
    </div>

    <p class="text-muted mt-3">
        Takip numarası, ücret ve tahmini teslim tarihi kargo oluşturulurken otomatik hesaplanır.
    </p>

    <button class="btn btn-dark">Kargoyu Oluştur</button>
    <a href="/Cargo/Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
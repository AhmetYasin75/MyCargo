<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @CargoTrack.WebUI.Consts.Brand.Name</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    @* Neden: Hocanın tasarımındaki renk/yazı/boşluk ayarları aynen korunur. *@
    <script id="tailwind-config">
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        "surface-container-high": "#dce9ff",
                        "on-surface-variant": "#43474e",
                        "on-secondary-container": "#603100",
                        "outline": "#74777e",
                        "secondary": "#904d00",
                        "background": "#f8f9ff",
                        "error": "#ba1a1a",
                        "on-background": "#0b1c30",
                        "surface-bright": "#f8f9ff",
                        "primary-fixed-dim": "#afc8ee",
                        "primary-fixed": "#d3e3ff",
                        "primary-container": "#001e3c",
                        "primary": "#00040c",
                        "on-primary": "#ffffff",
                        "error-container": "#ffdad6",
                        "outline-variant": "#c4c6ce",
                        "surface-container": "#e5eeff",
                        "on-primary-container": "#6f87aa",
                        "on-surface": "#0b1c30",
                        "surface-container-low": "#eff4ff",
                        "on-error-container": "#93000a",
                        "surface-tint": "#486081",
                        "surface": "#f8f9ff",
                        "secondary-container": "#fd8b00",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-highest": "#d3e4fe",
                        "on-secondary": "#ffffff"
                    },
                    borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", full: "9999px" },
                    spacing: {
                        "section-padding": "4rem",
                        "container-max-width": "1200px",
                        "stack-sm": "0.5rem",
                        "stack-md": "1rem",
                        "stack-lg": "2rem",
                        "gutter": "1.5rem",
                        "margin-mobile": "1rem"
                    },
                    fontFamily: {
                        "status-label": ["Hanken Grotesk"],
                        "body-lg": ["Hanken Grotesk"],
                        "headline-md": ["Hanken Grotesk"],
                        "headline-lg": ["Hanken Grotesk"],
                        "body-md": ["Hanken Grotesk"],
                        "headline-xl": ["Hanken Grotesk"],
                        "label-caps": ["Hanken Grotesk"]
                    },
                    fontSize: {
                        "status-label": ["13px", { lineHeight: "18px", fontWeight: "600" }],
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "headline-md": ["24px", { lineHeight: "32px", fontWeight: "600" }],
                        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "600" }],
                        "body-md": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "headline-xl": ["40px", { lineHeight: "48px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "label-caps": ["12px", { lineHeight: "16px", letterSpacing: "0.05em", fontWeight: "700" }]
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Hanken Grotesk', sans-serif;
            background-color: #f8f9ff;
            color: #0b1c30;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .filled-icon {
            font-variation-settings: 'FILL' 1;
        }

        .timeline-line::before {
            content: '';
            position: absolute;
            left: 11px;
            top: 24px;
            bottom: -24px;
            width: 2px;
            background-color: #E2E8F0;
            z-index: 0;
        }

        .timeline-item:last-child .timeline-line::before {
            display: none;
        }

        .progress-bar-bg {
            background-color: #334155;
        }

        .progress-bar-fill {
            background-color: #fd8b00;
        }

        @@media print {
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <nav class="bg-surface border-b border-outline-variant shadow-sm no-print">
        <div class="flex justify-between items-center px-gutter py-4 max-w-container-max-width mx-auto">
            <a href="/" class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">package_2</span>
                <span class="text-headline-md font-bold text-on-background">@CargoTrack.WebUI.Consts.Brand.Name</span>
            </a>
            <div class="hidden md:flex gap-6 items-center">
                <a class="text-secondary font-bold border-b-2 border-secondary pb-1" href="/">Kargo Takip</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors px-2 py-1 rounded" href="/Login/Index">Panelim</a>
                }
                else
                {
                    <a class="text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-colors px-2 py-1 rounded" href="/Login/Index">Giriş Yap</a>
                }
            </div>
            <a href="/Cargo/Create" class="bg-primary-container text-on-primary px-6 py-2.5 rounded font-semibold flex items-center gap-2 hover:bg-primary transition-colors">
                <span class="material-symbols-outlined text-sm">send</span>
                Kargo Gönder
            </a>
        </div>
    </nav>

    <main class="flex-grow max-w-container-max-width mx-auto w-full px-margin-mobile md:px-gutter py-section-padding">
        @RenderBody()
    </main>

    <footer class="bg-primary-container flex flex-col md:flex-row justify-between items-center px-gutter py-8 w-full mt-auto no-print">
        <div class="text-surface-bright mb-4 md:mb-0 opacity-90">
            © @DateTime.Now.Year @CargoTrack.WebUI.Consts.Brand.Company Tüm hakları saklıdır.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
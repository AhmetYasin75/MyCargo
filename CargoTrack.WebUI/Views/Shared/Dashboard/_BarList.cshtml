@using CargoTrack.WebUI.Models
@model BarListModel
@{
    // Neden: Çubuk uzunluğu en büyük değere göre oranlanır.
    var max = Model.Items.Any() ? Math.Max(Model.Items.Max(i => i.Value), 1) : 1;

    // Neden: Bootstrap renk adı hocanın paletine çevrilir.
    string Color(string css)
    {
        css ??= "";
        if (css.Contains("success")) return "#2e7d32";
        if (css.Contains("danger")) return "#ba1a1a";
        if (css.Contains("warning")) return "#fd8b00";
        if (css.Contains("info")) return "#486081";
        if (css.Contains("dark")) return "#213145";
        if (css.Contains("secondary")) return "#74777e";
        return "#001e3c";
    }
}

<div class="panel-card">
    <div class="panel-card-head">@Model.Title</div>
    <div class="panel-card-body">
        @if (!Model.Items.Any())
        {
            <p class="text-muted">@Model.EmptyText</p>
        }
        @foreach (var item in Model.Items)
        {
            var percent = item.Value * 100 / max;
            <div class="bar-row">
                <div class="bar-top"><span>@item.Label</span><strong>@item.Value</strong></div>
                <div class="bar-track"><div class="bar-fill" style="width:@(percent)%; background:@Color(item.CssClass)"></div></div>
            </div>
        }
    </div>
</div>
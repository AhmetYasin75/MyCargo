@using CargoTrack.DTO.DTOs.Common
@model PagedResultBase
@{
    // Neden: Sayfa değişince arama/filtre değerleri kaybolmasın. Mevcut URL'deki parametreler korunur,
    // sadece "page" değişir.
    string PageUrl(int page)
    {
        var parts = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? string.Empty)}"))
            .ToList();

        parts.Add($"page={page}");
        return $"{Context.Request.Path}?{string.Join("&", parts)}";
    }

    // Sayfa numaralarını mevcut sayfanın 2 önü ve 2 arkasıyla sınırlıyoruz
    int start = Math.Max(1, Model.PageNumber - 2);
    int end = Math.Min(Model.TotalPages, Model.PageNumber + 2);
}

@if (Model.TotalPages > 1)
{
    <nav aria-label="Sayfalama">
        <ul class="pagination">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link" href="@PageUrl(Model.PageNumber - 1)">Önceki</a>
            </li>

            @for (int i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@PageUrl(i)">@i</a>
                </li>
            }

            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link" href="@PageUrl(Model.PageNumber + 1)">Sonraki</a>
            </li>
        </ul>
    </nav>
}
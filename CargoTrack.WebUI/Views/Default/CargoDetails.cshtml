@using System.Globalization
@using CargoTrack.DTO.DTOs.Tracking
@using CargoTrack.Entity.Entities.Enums
@using CargoTrack.WebUI.Helpers
@model TrackingResultDto
@{
    ViewData["Title"] = "Gönderi Detayları";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";

    // Neden: Uygulama kültürü en-US; ay adları Türkçe görünsün diye tr-TR kullanılır.
    var tr = new CultureInfo("tr-TR");

    var isCompleted = Model.Status == CargoStatus.Delivered || Model.Status == CargoStatus.ReturnedToSender;
    var lastIndex = Model.Movements.Count - 1;

    string ChipClass() => Model.Status switch
    {
        CargoStatus.Delivered => "bg-[#e8f5e9] text-[#2e7d32]",
        CargoStatus.DeliveryFailed or CargoStatus.ReturnInProgress or CargoStatus.ReturnedToSender => "bg-error-container text-on-error-container",
        CargoStatus.InTransferCenter => "bg-[#fff3e0] text-[#e65100]",
        _ => "bg-surface-container-high text-primary-container"
    };
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
    <div>
        <h1 class="text-headline-lg text-primary-container mb-2">Gönderi Detayları</h1>
        <p class="text-on-surface-variant">Gönderinizin güncel durumunu ve hareket geçmişini inceleyin.</p>
    </div>
    <div class="flex gap-3 w-full md:w-auto no-print">
        <button type="button" onclick="window.print()"
                class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-surface-container-high text-primary-container border border-primary-container/20 px-4 py-2.5 rounded-lg font-semibold hover:bg-surface-container-highest transition-colors">
            <span class="material-symbols-outlined">print</span>
            Kargo Detayını Yazdır
        </button>
        <a href="/"
           class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-secondary-container text-on-secondary px-6 py-2.5 rounded-lg font-semibold hover:opacity-90 transition-opacity shadow-sm">
            <span class="material-symbols-outlined">search</span>
            Yeni Kargo Sorgula
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <div class="lg:col-span-8 flex flex-col gap-6">

        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col md:flex-row gap-8">
            <div class="flex-1 border-r-0 md:border-r border-outline-variant/30 pr-0 md:pr-6">
                <div class="mb-6">
                    <p class="text-label-caps text-outline mb-1 uppercase">Takip Numarası</p>
                    <h2 class="text-headline-md text-primary-container">@Model.TrackCode</h2>
                </div>
                <div class="inline-flex items-center gap-1.5 @ChipClass() px-3 py-1 rounded-full text-status-label mb-6">
                    <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                    @EnumDisplay.Status(Model.Status)
                </div>
                <div class="flex gap-8">
                    <div>
                        <p class="text-sm text-outline mb-1">Gönderim Tarihi</p>
                        <p class="font-semibold text-on-background">@Model.ShipmentDate.ToString("d MMMM yyyy", tr)</p>
                    </div>
                    <div>
                        <p class="text-sm text-outline mb-1">Tahmini Varış</p>
                        <p class="font-semibold text-on-background">@Model.EstimatedArrivalDate.ToString("d MMMM yyyy", tr)</p>
                    </div>
                </div>
            </div>

            <div class="flex-1 flex flex-col justify-center">
                <div class="flex justify-between items-center mb-2">
                    <div class="flex flex-col items-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center mb-2 text-primary-container">
                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">location_on</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.OriginCity</span>
                        <span class="text-xs text-outline">@Model.OriginBranch</span>
                    </div>
                    <div class="flex-grow flex items-center px-2">
                        <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                        <div class="flex-grow h-px bg-outline-variant relative">
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-lowest px-2">
                                <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                            </div>
                        </div>
                        <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                    </div>
                    <div class="flex flex-col items-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container text-outline flex items-center justify-center mb-2">
                            <span class="material-symbols-outlined text-[18px]">flag</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.DestinationCity</span>
                        <span class="text-xs text-outline">@Model.DestinationBranch</span>
                    </div>
                </div>
            </div>
        </div>

        @* Neden: Hocanın şablonundaki gönderici/alıcı kartları kişisel veri içerdiği için herkese açık sayfada yok. *@
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">
            <h3 class="text-xl font-semibold text-primary-container mb-4">Kargo Bilgileri</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Ağırlık</p><p class="font-semibold text-on-background">@Model.Weight.ToString("0.##", CultureInfo.InvariantCulture) kg</p></div>
                <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Desi</p><p class="font-semibold text-on-background">@Model.Desi.ToString("0.##", CultureInfo.InvariantCulture)</p></div>
                <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Kargo Türü</p><p class="font-semibold text-on-background">@EnumDisplay.Type(Model.CargoType)</p></div>
                <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Teslimat Tipi</p><p class="font-semibold text-on-background">@EnumDisplay.Delivery(Model.DeliveryType)</p></div>
                <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Çıkış Şubesi</p><p class="font-semibold text-on-background">@Model.OriginBranch</p></div>
                <div class="bg-surface rounded-lg p-4"><p class="text-sm text-outline mb-1">Varış Şubesi</p><p class="font-semibold text-on-background">@Model.DestinationBranch</p></div>
            </div>
        </div>

        <div class="bg-primary-container rounded-xl shadow-sm p-6 text-on-primary">
            <div class="flex items-center gap-3 mb-2">
                <span class="material-symbols-outlined text-[28px]">schedule</span>
                @if (Model.Status == CargoStatus.Delivered)
                {
                    <h3 class="text-2xl font-bold">Teslim Edildi: @Model.DeliveredDate?.ToString("d MMMM yyyy", tr)</h3>
                }
                else if (Model.Status == CargoStatus.ReturnedToSender)
                {
                    <h3 class="text-2xl font-bold">Kargo göndericiye iade edildi</h3>
                }
                else
                {
                    <h3 class="text-2xl font-bold">Tahmini Teslimat: @Model.EstimatedArrivalDate.ToString("d MMMM yyyy", tr)</h3>
                }
            </div>
            @if (Model.IsOverdue)
            {
                <p class="text-primary-fixed-dim mb-6 ml-10">Tahmini teslimat tarihi geçti, kargonuz için çalışıyoruz.</p>
            }
            else if (!string.IsNullOrEmpty(Model.LastLocation))
            {
                <p class="text-primary-fixed-dim mb-6 ml-10">Son konum: @Model.LastLocation</p>
            }
            else
            {
                <div class="mb-6"></div>
            }
            <div class="relative w-full h-3 progress-bar-bg rounded-full overflow-hidden mb-2">
                <div class="absolute top-0 left-0 h-full progress-bar-fill rounded-full" style="width: @(Model.ProgressPercent)%;"></div>
            </div>
            <div class="flex justify-between text-xs text-primary-fixed-dim">
                <span>Gönderi Kabul</span>
                <span>Teslimat</span>
            </div>
        </div>
    </div>

    <div class="lg:col-span-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 h-full">
            <div class="flex items-center gap-2 mb-6 pb-4 border-b border-outline-variant/30">
                <span class="material-symbols-outlined text-primary-container">history</span>
                <h3 class="text-xl font-semibold text-primary-container">Kargo Hareketleri</h3>
            </div>

            <div class="relative">
                @for (var i = 0; i < Model.Movements.Count; i++)
                {
                    var m = Model.Movements[i];
                    // Neden: Son hareket "güncel adım" (turuncu); kargo tamamlandıysa o da yeşil olur.
                    var isCurrent = i == lastIndex && !isCompleted;
                    

                    <div class="timeline-item relative pb-8 pl-10">
                        <div class="timeline-line"></div>
                        @if (isCurrent)
                        {
                            <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-secondary-container text-white flex items-center justify-center z-10 ring-4 ring-white">
                                <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                            </div>
                            <p class="font-semibold text-secondary-container mb-1">@EnumDisplay.Status(m.Status)</p>
                        }
                        else
                        {
                            <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center z-10 ring-4 ring-white">
                                <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                            </div>
                            <p class="font-semibold text-on-background mb-1">@EnumDisplay.Status(m.Status)</p>
                        }
                        <div class="flex items-center gap-1 text-sm text-outline">
                            <span class="material-symbols-outlined text-[16px]">location_on</span>
                            @if (!string.IsNullOrEmpty(m.Location))
                            {
                                <span>@m.Location • </span>
                            }
                            @m.MovementDate.ToString("d MMM, HH:mm", tr)
                        </div>
                    </div>
                }

                @if (!isCompleted)
                {
                    <div class="timeline-item relative pl-10">
                        <div class="absolute left-0 top-1 w-6 h-6 rounded-full border-2 border-outline-variant bg-white z-10"></div>
                        <p class="font-semibold text-outline mb-1">Teslim Edildi</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@using CargoTrack.DTO.DTOs.AuditLogDtos
@using CargoTrack.DTO.DTOs.Common
@using CargoTrack.Entity.Entities.Enums
@using CargoTrack.WebUI.Helpers
@model PagedResult<ResultAuditLogDto>
@{
    ViewData["Title"] = "Audit Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var filter = (AuditLogFilterDto)ViewBag.Filter;
    var entityNames = (List<string>)ViewBag.EntityNames;
}

<h3>Audit Log</h3>

<p class="text-muted">Sistemdeki oluşturma, güncelleme, silme ve durum değişikliği kayıtları. Bu kayıtlar değiştirilemez ve silinemez.</p>

@* Arama ve filtre GET ile gönderilir, böylece sayfalama filtreyi korur *@
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="text" name="search" value="@filter.Search" class="form-control"
               placeholder="Açıklama, varlık veya kullanıcı ara..." />
    </div>

    <div class="col-md-2">
        <select name="actionType" class="form-select">
            <option value="">Tüm işlemler</option>
            @foreach (var a in Enum.GetValues<AuditActionType>())
            {
                <option value="@((int)a)" selected="@(filter.ActionType == a)">@EnumDisplay.AuditAction(a)</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <select name="entityName" class="form-select">
            <option value="">Tüm varlıklar</option>
            @foreach (var n in entityNames)
            {
                <option value="@n" selected="@(filter.EntityName == n)">@EnumDisplay.EntityName(n)</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <input type="date" name="dateFrom" value="@filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" title="Başlangıç tarihi" />
    </div>

    <div class="col-md-2">
        <input type="date" name="dateTo" value="@filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" title="Bitiş tarihi" />
    </div>

    <div class="col-12">
        <button class="btn btn-dark">Filtrele</button>
        <a href="/Admin/AuditLog/Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Kullanıcı</th>
            <th>İşlem</th>
            <th>Varlık</th>
            <th>Açıklama</th>
            <th>Detay</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td>
            </tr>
        }

        @foreach (var item in Model.Items)
        {
            <tr>
                <td class="text-nowrap">@item.CreatedDate.ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td>@(string.IsNullOrEmpty(item.UserName) ? "Sistem/Anonim" : item.UserName)</td>
                <td><span class="badge @EnumDisplay.AuditBadge(item.ActionType)">@EnumDisplay.AuditAction(item.ActionType)</span></td>
                <td>@EnumDisplay.EntityName(item.EntityName)</td>
                <td>@AuditText.Description(item.Description)</td>
                <td>
                    @* Neden: Eski/yeni değerler uzun olabilir, liste şişmesin diye açılır/kapanır *@
                    <details>
                        <summary>Göster</summary>
                        <div class="small mt-2">
                            <div><strong>Kayıt Id:</strong> @item.EntityId</div>
                            <div class="mt-1"><strong>Eski değer:</strong></div>
                            <pre class="mb-1" style="white-space:pre-wrap;word-break:break-all">@(item.OldValue ?? "-")</pre>
                            <div><strong>Yeni değer:</strong></div>
                            <pre class="mb-0" style="white-space:pre-wrap;word-break:break-all">@(item.NewValue ?? "-")</pre>
                        </div>
                    </details>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span class="text-muted">Toplam @Model.TotalCount kayıt</span>
    <partial name="_Pagination" model="Model" />
</div>
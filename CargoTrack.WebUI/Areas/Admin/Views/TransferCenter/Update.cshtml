@using CargoTrack.DTO.DTOs.TransferCenterDtos
@model UpdateTransferCenterDto
@{
    ViewData["Title"] = "Transfer Merkezi Güncelle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Transfer Merkezi Güncelle</h3>

<form asp-area="Admin" asp-controller="TransferCenter" asp-action="Update" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Merkez Adı</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CityId" class="form-label">Şehir</label>
        <select asp-for="CityId" class="form-select" asp-items="@((SelectList)ViewBag.Cities)"></select>
        <span asp-validation-for="CityId" class="text-danger"></span>
    </div>

    <button class="btn btn-dark">Güncelle</button>
    <a href="/Admin/TransferCenter/Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
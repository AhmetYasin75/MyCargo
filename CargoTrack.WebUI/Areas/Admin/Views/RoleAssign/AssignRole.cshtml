@model List<RoleAssignDto>
@{
    ViewData["Title"] = "AssignRole";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3>Rol Atama</h3>

<h4> <strong>@ViewBag.fullName kullanıcısına rol atama işlemlerini aşağıdan gerçekleştirebilirsiniz.</strong> </h4>

<form method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    @for (int i = 0; i < Model.Count; i++)
    {
        <div>
            <input type="checkbox" asp-for="@Model[i].RoleExist" />
            <label>@Model[i].RoleName</label>

            <input type="hidden" asp-for="@Model[i].RoleName" />
            <input type="hidden" asp-for="@Model[i].RoleId" />
            <input type="hidden" asp-for="@Model[i].UserId" />
        </div>
    }

    <div class="mt-3 mb-3">
        <label for="branchId"><strong>Şube</strong> (Manager rolü için zorunlu)</label>
        <select id="branchId" name="branchId" class="form-select" asp-items="@((SelectList)ViewBag.Branches)">
            <option value="">-- Şube seçiniz --</option>
        </select>
    </div>

    <button class="btn btn-primary">Rol Ata</button>

</form>